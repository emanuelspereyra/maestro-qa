# Copy to a local .env and keep it untracked. Never commit real credentials.
# Select one authorized execution profile.
QA_DEFAULT_ENV=qa
QA_TARGET_ENV=main
QA_ALLOWED_ENVIRONMENTS=dev,main,qa,staging

# Configure values only for environments that will be used.
QA_DEV_FRONTEND_URL=https://dev.example.test
QA_DEV_API_BASE_URL=https://api.dev.example.test
QA_DEV_AUTH_URL=
QA_DEV_ADMIN_URL=
QA_DEV_OPENAPI_URL=
QA_DEV_TEST_USERNAME=
QA_DEV_TEST_PASSWORD=
QA_DEV_DB_READ_CONNECTION=
QA_DEV_DB_WRITE_CONNECTION=

QA_MAIN_FRONTEND_URL=https://main.example.test
QA_MAIN_API_BASE_URL=https://api.main.example.test
QA_MAIN_AUTH_URL=
QA_MAIN_ADMIN_URL=
QA_MAIN_OPENAPI_URL=
QA_MAIN_TEST_USERNAME=
QA_MAIN_TEST_PASSWORD=
QA_MAIN_DB_READ_CONNECTION=
QA_MAIN_DB_WRITE_CONNECTION=

# Generic variables are ignored unless this is explicitly enabled.
QA_ALLOW_GENERIC_ENV_FALLBACK=false

# Keep production and DB writes disabled unless separately authorized.
QA_ALLOW_PRODUCTION=false
QA_ALLOW_DB_WRITE=false
QA_ALLOWED_DB_WRITE_ENVIRONMENTS=dev,qa,staging,test
