{
  "service": "example-provider-sandbox",
  "contract_version": "2026-08-04",
  "default_scenario": "success",
  "routes": [
    {
      "method": "POST",
      "path": "/v1/resources",
      "default_scenario": "success",
      "scenarios": {
        "success": {
          "status": 201,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "id": "ext-qa-0001",
            "status": "created"
          }
        },
        "validation-error": {
          "status": 422,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "code": "INVALID_REQUEST",
            "message": "Synthetic validation error"
          }
        },
        "rate-limit": {
          "status": 429,
          "headers": {
            "Content-Type": "application/json",
            "Retry-After": "1"
          },
          "body": {
            "code": "RATE_LIMITED"
          }
        },
        "slow-success": {
          "status": 201,
          "delay_ms": 1500,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "id": "ext-qa-slow-0001",
            "status": "created"
          }
        },
        "provider-error": {
          "status": 503,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "code": "PROVIDER_UNAVAILABLE"
          }
        },
        "malformed-response": {
          "status": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{\"id\":"
        }
      }
    }
  ]
}
