# Credenciales propias de Maestro QA (el orquestador y sus agentes) — NO las del
# proyecto del cliente bajo prueba, esas usan el prefijo QA_<AMBIENTE>_* y viven en
# vendor/qa-intelligent-skill-bundle/skills/generate-qa-from-test-cases/assets/playwright-python/.
#
# Copiar a .env (gitignored) y completar solo lo que corresponda a las integraciones
# activas. No commitear valores reales.

# Motor core (spec 001) — OPCIONAL. Solo hace falta si vas a usar el modo run_qa/MCP
# desacoplado (ver README "1b"). El modo default (fleet local, sin API key, usa la
# sesión/suscripción de tu asistente ya activo) NO necesita nada de esto — ver
# skills/maestro-qa-fleet-local/SKILL.md. Nunca se usa una API key paga de Anthropic
# para esto (descartado explícitamente); si necesitás este modo, MAESTRO_PROVIDER=gemini
# es la única opción evaluada hasta ahora.
MAESTRO_PROVIDER=
MAESTRO_MODEL=
MAESTRO_API_KEY=

# Writer hacia repo de código, CDA-60/spec 026 — push + PR automático (nunca auto-merge)
# del código que generan automatizacion/automatizacion_api, solo si repositories.automation
# está configurado en qa-project.yaml. Sin este token, se comitea local nomás.
# Necesita permiso de escritura en el repo de automation configurado. Si ese repo NO es
# github.com, se pushea igual pero el PR hay que abrirlo a mano (solo GitHub por ahora).
MAESTRO_GITHUB_TOKEN=

# Writer de integraciones de salida (casos_manuales publica un work item por caso),
# CDA-58/spec 027 — opcional, sin MAESTRO_WRITER seteada no cambia nada del
# comportamiento actual. Un solo backend implementado por ahora: azure_devops.
# Xray (CDA-59, descartado, CDA no usa Xray) / Jira nativo (CDA-72) / Trello (CDA-73) /
# ALM Octane (CDA-74) / Linear quedan de backlog, mismo protocolo Writer.
MAESTRO_WRITER=
MAESTRO_AZURE_DEVOPS_ORG=
MAESTRO_AZURE_DEVOPS_PROJECT=
MAESTRO_AZURE_DEVOPS_PAT=
MAESTRO_AZURE_DEVOPS_WORK_ITEM_TYPE=Task

# Reader de integraciones de entrada (tool run_qa_from_work_item), spec 028 — opcional,
# trae un work item real de Azure DevOps por ID en vez de pegar el texto del ticket a
# mano. Reusa las MAESTRO_AZURE_DEVOPS_* de arriba (mismo org/project) — este flag solo
# habilita la lectura, independiente de si el writer está activo.
MAESTRO_READER=

# Lectura de hallazgos de SonarQube/SonarCloud para el agente seguridad, CDA-82/spec 014
# — opcional, seguridad funciona igual sin esto. base_url self-hosted o
# https://sonarcloud.io si es SonarCloud.
MAESTRO_SONARQUBE_URL=
MAESTRO_SONARQUBE_TOKEN=
MAESTRO_SONARQUBE_PROJECT_KEY=

# Modo efímero (spec 015): levanta SonarQube en Docker, escanea y mata el contenedor
# por corrida — NO VALIDADO contra un servidor real todavía, correr
# scripts/sonarqube_smoke_test.py antes de confiar en esto. Tarda minutos y necesita
# Docker con memoria disponible. Si se activa, ignora MAESTRO_SONARQUBE_URL/TOKEN de
# arriba (genera su propio token efímero).
MAESTRO_SONARQUBE_EPHEMERAL=false
MAESTRO_SONARQUBE_SCAN_PATH=
